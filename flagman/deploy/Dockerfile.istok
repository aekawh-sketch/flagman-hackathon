# Сайт ИСТОК с панелью ресторана (касса, заказы, курьер, списание) — рядом со складом на VPS.
# deploy.sh кладёт рядом istok/: server (без .env и выгрузок заказов), site, seed/menu.json, init-db.js.
FROM node:22-alpine

WORKDIR /app
COPY istok /app
WORKDIR /app/server
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

ENV NODE_ENV=production \
    PORT=3001
EXPOSE 3001

# Сначала базы заказов (создать и дополнить схему), потом сервер сайта
CMD ["sh", "-c", "node init-db.js && exec node server.js"]
