# Портал поставщика «ФрешПоставка» — шлёт накладные в склад по API (ключ поставщика, одно право deliveries:create).
# deploy.sh кладёт рядом supplier/: server.js, public, package.json — без .env. Зависимостей нет.
FROM node:22-alpine

WORKDIR /app
COPY supplier /app

ENV NODE_ENV=production \
    PORT=3002 \
    HOST=0.0.0.0
EXPOSE 3002

CMD ["node", "server.js"]
